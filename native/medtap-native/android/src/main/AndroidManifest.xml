<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Health Connect, read only (minSdk 26 for its library; calls are guarded by the Android version). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Reminder check: ask to run reminders without battery restrictions. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- One-tap updates: open Android's installer for a newer build downloaded from the app's GitHub release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <service android:name="app.medtap.nativeplugin.MedTapWearListener" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/medtap" />
            </intent-filter>
        </service>
        <!-- Home-screen widgets (all drawn from one payload the app saves; see WidgetStore). Each app turns off the ones it has
             no use for with the mw_*_widget(s) bools in its own resources: next dose, focus window and at a glance need
             medicines; shot week needs peptides; protein and water, and training, need training; weight trend needs weight. -->
        <receiver android:name="app.medtap.nativeplugin.DoseWidget" android:exported="true" android:enabled="@bool/mw_med_widgets" android:label="@string/medtap_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/medtap_widget_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.WearWidget" android:exported="true" android:enabled="@bool/mw_med_widgets" android:label="@string/mw_wear_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_wear_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.ShotWidget" android:exported="true" android:enabled="@bool/mw_shot_widget" android:label="@string/mw_shot_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_shot_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.IntakeWidget" android:exported="true" android:enabled="@bool/mw_training_widgets" android:label="@string/mw_intake_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_intake_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.QuickWidget" android:exported="true" android:label="@string/mw_quick_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_quick_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.WeightWidget" android:exported="true" android:enabled="@bool/mw_body_widgets" android:label="@string/mw_weight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_weight_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.TrainingWidget" android:exported="true" android:enabled="@bool/mw_training_widgets" android:label="@string/mw_training_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_training_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.GlanceWidget" android:exported="true" android:enabled="@bool/mw_med_widgets" android:label="@string/mw_glance_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mw_glance_info" />
        </receiver>
        <receiver android:name="app.medtap.nativeplugin.WidgetActionReceiver" android:exported="false" />
    </application>
</manifest>
