<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/medtap_widget_bg">

    <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#6B6B6B" android:textSize="12sp" />
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#0A0A0A" android:textSize="20sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#0A0A0A" android:textSize="15sp" />
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#6B6B6B" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#6B6B6B" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <Button android:id="@+id/widget_prn1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFFFFF" android:background="@drawable/medtap_widget_button" android:visibility="gone" />
        <Button android:id="@+id/widget_prn2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:layout_marginStart="8dp" android:textSize="13sp" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:background="@drawable/medtap_widget_button" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
