<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/medtap_widget_bg">
    <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
        <ProgressBar android:id="@+id/widget_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="64dp" android:layout_height="64dp"
            android:indeterminate="false" android:max="100" android:progress="0" android:progressDrawable="@drawable/mw_ring" />
        <TextView android:id="@+id/widget_ring_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:textColor="@color/mw_text" android:textSize="15sp" android:textStyle="bold" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mw_text" android:textSize="19sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/widget_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/mw_muted" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <Button android:id="@+id/widget_log" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="64dp" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/mw_on_accent" android:background="@drawable/medtap_widget_button" android:text="Log" />
    <Button android:id="@+id/widget_prn1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/widget_prn2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
