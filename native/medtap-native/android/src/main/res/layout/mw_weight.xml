<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mw_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/medtap_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/mw_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_text" android:textSize="22sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="1"/>
        <TextView android:id="@+id/mw_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/mw_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitXY" android:contentDescription="Weight trend" />
</LinearLayout>
