<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mw_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp" android:background="@drawable/medtap_widget_bg">
    <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
        <ProgressBar android:id="@+id/mw_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="72dp" android:layout_height="72dp" android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/mw_ring" />
        <TextView android:id="@+id/mw_ring_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/mw_text" android:textSize="15sp" android:textStyle="bold" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/mw_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_text" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/mw_steps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        <TextView android:id="@+id/mw_change" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/mw_text" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
