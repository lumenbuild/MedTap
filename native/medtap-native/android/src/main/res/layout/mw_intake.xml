<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mw_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:padding="12dp" android:background="@drawable/medtap_widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
            <ProgressBar android:id="@+id/mw_p_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="64dp" android:layout_height="64dp" android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/mw_ring" />
            <TextView android:id="@+id/mw_p_val" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/mw_text" android:textSize="13sp" android:textStyle="bold" />
        </FrameLayout>
        <TextView android:id="@+id/mw_p_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="12sp" />
        <Button android:id="@+id/mw_p_add" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginTop="4dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/mw_text" android:background="@drawable/mw_chip" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
            <ProgressBar android:id="@+id/mw_w_ring" style="?android:attr/progressBarStyleHorizontal" android:layout_width="64dp" android:layout_height="64dp" android:indeterminate="false" android:max="100" android:progressDrawable="@drawable/mw_ring" />
            <TextView android:id="@+id/mw_w_val" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/mw_text" android:textSize="13sp" android:textStyle="bold" />
        </FrameLayout>
        <TextView android:id="@+id/mw_w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/mw_muted" android:textSize="12sp" />
        <Button android:id="@+id/mw_w_add" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginTop="4dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/mw_text" android:background="@drawable/mw_chip" />
    </LinearLayout>
</LinearLayout>
