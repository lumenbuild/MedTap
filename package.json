{
  "name": "med-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:native": "NATIVE=1 VITE_TAG_BASE=https://lumenbuild.github.io/MedTap/ vite build --outDir dist-native && cap sync",
