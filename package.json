    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dexie": "^4.4.6",
    "lucide-react": "^1.59.0",
    "medtap-native": "file:native/medtap-native",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
